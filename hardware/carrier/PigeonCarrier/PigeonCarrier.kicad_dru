(version 1)


# BEGIN GENERATED JLC FABRICATION RULES
# 6-layer, 1 oz outer / 0.5 oz inner, ENIG and epoxy-filled/capped through vias; checked 2026-11-07.
# Fixed same-package pads are exempt only from the 0.5 mm impedance-model
# spacing above. Dense footprint launches have separate track-to-pad rules.
# JLC minimum different-net SMD land spacing applies to all SMD pad pairs.
(rule "JLC SMD pad spacing"
 (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Pad_Type == 'SMD' && B.Pad_Type == 'SMD' && A.Parent == B.Parent")
 (constraint clearance (min 0.15mm)))
(rule "JLC separate SMD footprint pad spacing"
 (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Pad_Type == 'SMD' && B.Pad_Type == 'SMD' && A.Parent != B.Parent && !(A.hasNetclass('CSI_100R') || B.hasNetclass('CSI_100R') || A.hasNetclass('ETH_100R') || B.hasNetclass('ETH_100R') || A.hasNetclass('USB_90R') || B.hasNetclass('USB_90R') || A.hasNetclass('SE_50R') || B.hasNetclass('SE_50R'))")
 (constraint clearance (min 0.15mm)))
(rule "JLC PTH annular ring"
 (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
 (constraint annular_width (min 0.15mm)))
(rule "JLC PTH hole to unrelated copper"
 (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
 (constraint hole_clearance (min 0.28mm)))
(rule "JLC inner PTH hole to unrelated copper"
 (layer inner)
 (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
 (constraint hole_clearance (min 0.30mm)))
(rule "JLC drilled pad hole separation"
 (condition "A.Type == 'Pad' || B.Type == 'Pad'")
 (constraint hole_to_hole (min 0.45mm)))
(rule "JLC round NPTH minimum"
 (condition "A.Type == 'Pad' && A.Pad_Type == 'NPTH, mechanical'")
 (constraint hole_size (min 0.50mm)))
(rule "Standard through-via process"
 (constraint disallow micro_via blind_via buried_via))
# END GENERATED JLC FABRICATION RULES

# BEGIN GENERATED CARRIER IMPEDANCE RULES
# Six-layer JLC06161H-3313; checked 2026-11-07.
(rule "outer 100 ohm trace geometry" (layer outer) (condition "A.hasNetclass('CSI_100R') || A.hasNetclass('ETH_100R')") (constraint track_width (min 0.15mm) (opt 0.15mm) (max 0.15mm)) (constraint diff_pair_gap (min 0.5mm) (opt 0.5mm) (max 0.5mm)))
(rule "outer 90 ohm trace geometry" (layer outer) (condition "A.hasNetclass('USB_90R')") (constraint track_width (min 0.175mm) (opt 0.175mm) (max 0.175mm)) (constraint diff_pair_gap (min 0.3mm) (opt 0.3mm) (max 0.3mm)))
(rule "outer 50 ohm trace geometry" (layer outer) (condition "A.hasNetclass('SE_50R')") (constraint track_width (min 0.16mm) (opt 0.16mm) (max 0.16mm)))
(rule "L3 100 ohm trace geometry" (layer "In2.Cu") (condition "A.hasNetclass('CSI_100R') || A.hasNetclass('ETH_100R')") (constraint track_width (min 0.125mm) (opt 0.125mm) (max 0.125mm)) (constraint diff_pair_gap (min 0.3mm) (opt 0.3mm) (max 0.3mm)))
(rule "L3 90 ohm trace geometry" (layer "In2.Cu") (condition "A.hasNetclass('USB_90R')") (constraint track_width (min 0.16mm) (opt 0.16mm) (max 0.16mm)) (constraint diff_pair_gap (min 0.3mm) (opt 0.3mm) (max 0.3mm)))
(rule "L3 50 ohm trace geometry" (layer "In2.Cu") (condition "A.hasNetclass('SE_50R')") (constraint track_width (min 0.14mm) (opt 0.14mm) (max 0.14mm)))
(rule "In1.Cu ground reference" (layer "In1.Cu") (condition "A.NetName != 'GND'") (constraint disallow track zone))
(rule "In3.Cu ground reference" (layer "In3.Cu") (condition "A.NetName != 'GND'") (constraint disallow track zone))
(rule "In4.Cu ground reference" (layer "In4.Cu") (condition "A.NetName != 'GND'") (constraint disallow track zone))
# Outer defaults come from netclasses; L3 geometry comes from layer rules. Connector escapes and nearby
# surface copper require layout review of the noncoplanar model.
(rule "CSI within-pair matching"
 (condition "A.hasNetclass('CSI_100R')")
 (constraint skew (max 0.15mm) (within_diff_pairs)))
(rule "Ethernet within-pair matching"
 (condition "A.hasNetclass('ETH_100R')")
 (constraint skew (max 0.15mm) (within_diff_pairs)))
(rule "USB within-pair matching"
 (condition "A.hasNetclass('USB_90R')")
 (constraint skew (max 0.15mm) (within_diff_pairs)))
# Model spacing for the ordinary differential-pair route.
# The escape rules below apply only to dense connector and IC fanout.
(rule "Controlled impedance spacing to unrelated copper"
 (condition "(A.hasNetclass('CSI_100R') || A.hasNetclass('ETH_100R') || A.hasNetclass('USB_90R') || A.hasNetclass('SE_50R')) && !AB.isCoupledDiffPair() && !(A.Type == 'Pad' && B.Type == 'Pad' && A.Parent == B.Parent)")
 (constraint clearance (min 0.5mm)))
# First tracks at dense parts need 0.20 mm pad clearance.
# Exempt only an escape against a pad on that same footprint.
(rule "Controlled impedance footprint escape" (layer "F.Cu") (condition "(A.hasNetclass('CSI_100R') || A.hasNetclass('ETH_100R') || A.hasNetclass('USB_90R') || A.hasNetclass('SE_50R') || B.hasNetclass('CSI_100R') || B.hasNetclass('ETH_100R') || B.hasNetclass('USB_90R') || B.hasNetclass('SE_50R')) && !AB.isCoupledDiffPair() && B.Type == 'Pad' && (A.Type == 'Track' || A.Type == 'Arc' || A.Type == 'Via') && ((B.memberOfFootprint('J3') && A.intersectsFrontCourtyard('J3')) || (B.memberOfFootprint('J5') && A.intersectsFrontCourtyard('J5')) || (B.memberOfFootprint('J7') && A.intersectsFrontCourtyard('J7')) || (B.memberOfFootprint('J8') && A.intersectsFrontCourtyard('J8')) || (B.memberOfFootprint('J9') && A.intersectsFrontCourtyard('J9')) || (B.memberOfFootprint('J10') && A.intersectsFrontCourtyard('J10')) || (B.memberOfFootprint('U11') && A.intersectsFrontCourtyard('U11')) || (B.memberOfFootprint('U13') && A.intersectsFrontCourtyard('U13')) || (B.memberOfFootprint('U5') && A.intersectsFrontCourtyard('U5')) || (B.memberOfFootprint('U6') && A.intersectsFrontCourtyard('U6')) || (B.memberOfFootprint('J13') && A.intersectsFrontCourtyard('J13')) || (B.memberOfFootprint('R42') && A.intersectsFrontCourtyard('R42')))") (constraint clearance (min 0.20mm)))
# 0.40 mm CM5 pad pitch minus 0.15 mm trace width gives 0.25 mm at the neck.
(rule "CM5 differential pair launch gap"
 (layer "F.Cu")
 (condition "(A.hasNetclass('CSI_100R') || A.hasNetclass('ETH_100R')) && (A.intersectsFrontCourtyard('J3') || A.intersectsFrontCourtyard('J5'))")
 (constraint diff_pair_gap (min 0.15mm) (opt 0.25mm)))
(rule "CSI_100R short F.Cu launch" (layer "F.Cu") (condition "A.hasNetclass('CSI_100R') && (A.intersectsFrontCourtyard('J5') || A.intersectsFrontCourtyard('J7') || A.intersectsFrontCourtyard('J8'))") (constraint diff_pair_gap (min 0.15mm) (opt 0.25mm) (max 0.5mm)))
(rule "ETH_100R short F.Cu launch" (layer "F.Cu") (condition "A.hasNetclass('ETH_100R') && (A.intersectsFrontCourtyard('J3') || A.intersectsFrontCourtyard('J9') || A.intersectsFrontCourtyard('U5') || A.intersectsFrontCourtyard('U6'))") (constraint diff_pair_gap (min 0.15mm) (opt 0.25mm) (max 0.5mm)))
(rule "USB_90R short F.Cu launch" (layer "F.Cu") (condition "A.hasNetclass('USB_90R') && (A.intersectsFrontCourtyard('J5') || A.intersectsFrontCourtyard('J10') || A.intersectsFrontCourtyard('U11') || A.intersectsFrontCourtyard('U13'))") (constraint diff_pair_gap (min 0.15mm) (opt 0.225mm) (max 0.3mm)))
# High-current switch-node stubs. Keep the top copper path to the inductor short.
(rule "Buck switch node width"
 (layer "F.Cu")
 (condition "A.NetName == 'Net-(U7-SW)' || A.NetName == 'Net-(U9-SW)' || A.NetName == 'Net-(U10-SW)'")
 (constraint track_width (min 0.20mm) (opt 0.50mm)))
(rule "General via annular ring"
 (condition "A.Type == 'Via'")
 (constraint annular_width (min 0.125mm)))
# These exact through-via sizes override the general annular-ring rule.
(rule "0.45/0.3 mm through-via annular ring"
 (condition "A.Type == 'Via' && A.Diameter == 0.45mm && A.Hole == 0.3mm")
 (constraint annular_width (min 0.075mm)))
(rule "0.5/0.3 mm through-via annular ring"
 (condition "A.Type == 'Via' && A.Diameter == 0.5mm && A.Hole == 0.3mm")
 (constraint annular_width (min 0.1mm)))
# END GENERATED CARRIER IMPEDANCE RULES

# CAM0 retained at 0.450 mm pitch. With 0.125 mm width, the 0.325 mm gap models 101.2 ohms.
(rule "CAM0 L3 existing coupled runs"
 (layer "In2.Cu")
 (condition "A.NetName == '/CM5/MIPI0_D0_P' || A.NetName == '/CM5/MIPI0_D0_N' || A.NetName == '/CM5/MIPI0_D1_P' || A.NetName == '/CM5/MIPI0_D1_N' || A.NetName == '/CM5/MIPI0_D2_P' || A.NetName == '/CM5/MIPI0_D2_N' || A.NetName == '/CM5/MIPI0_D3_P' || A.NetName == '/CM5/MIPI0_D3_N' || A.NetName == '/CM5/MIPI0_CLK_P' || A.NetName == '/CM5/MIPI0_CLK_N'")
 (constraint diff_pair_gap (min 0.30mm) (opt 0.30mm) (max 0.326mm)))

# Let SPI escapes pass adjacent tracks and vias at J3 on the signal layers.
(rule "CM5 SPI launch spacing on F.Cu"
 (layer "F.Cu")
 (condition "(A.hasNetclass('SE_50R') || B.hasNetclass('SE_50R')) && (A.Type == 'Track' || A.Type == 'Arc' || A.Type == 'Via') && (B.Type == 'Track' || B.Type == 'Arc' || B.Type == 'Via') && !A.hasNetclass('CSI_100R') && !A.hasNetclass('ETH_100R') && !A.hasNetclass('USB_90R') && !B.hasNetclass('CSI_100R') && !B.hasNetclass('ETH_100R') && !B.hasNetclass('USB_90R') && A.intersectsFrontCourtyard('J3') && B.intersectsFrontCourtyard('J3')")
 (constraint clearance (min 0.20mm)))
(rule "CM5 SPI launch spacing on In2.Cu"
 (layer "In2.Cu")
 (condition "(A.hasNetclass('SE_50R') || B.hasNetclass('SE_50R')) && (A.Type == 'Track' || A.Type == 'Arc' || A.Type == 'Via') && (B.Type == 'Track' || B.Type == 'Arc' || B.Type == 'Via') && !A.hasNetclass('CSI_100R') && !A.hasNetclass('ETH_100R') && !A.hasNetclass('USB_90R') && !B.hasNetclass('CSI_100R') && !B.hasNetclass('ETH_100R') && !B.hasNetclass('USB_90R') && A.intersectsFrontCourtyard('J3') && B.intersectsFrontCourtyard('J3')")
 (constraint clearance (min 0.20mm)))

# Allow adjacent copper to pass the CSI launches at the CM5 high-speed connector.
(rule "CM5 CSI launch spacing on F.Cu"
 (layer "F.Cu")
 (condition "(A.hasNetclass('CSI_100R') || B.hasNetclass('CSI_100R')) && !AB.isCoupledDiffPair() && (A.Type == 'Track' || A.Type == 'Arc' || A.Type == 'Via') && (B.Type == 'Track' || B.Type == 'Arc' || B.Type == 'Via') && A.intersectsFrontCourtyard('J5') && B.intersectsFrontCourtyard('J5')")
 (constraint clearance (min 0.20mm)))
(rule "CM5 CSI launch spacing on In2.Cu"
 (layer "In2.Cu")
 (condition "(A.hasNetclass('CSI_100R') || B.hasNetclass('CSI_100R')) && !AB.isCoupledDiffPair() && (A.Type == 'Track' || A.Type == 'Arc' || A.Type == 'Via') && (B.Type == 'Track' || B.Type == 'Arc' || B.Type == 'Via') && A.intersectsFrontCourtyard('J5') && B.intersectsFrontCourtyard('J5')")
 (constraint clearance (min 0.20mm)))

# Allow adjacent copper to pass the Ethernet launches at the CM5 GPIO connector.
(rule "CM5 Ethernet launch spacing on F.Cu"
 (layer "F.Cu")
 (condition "(A.hasNetclass('ETH_100R') || B.hasNetclass('ETH_100R')) && !AB.isCoupledDiffPair() && (A.Type == 'Track' || A.Type == 'Arc' || A.Type == 'Via') && (B.Type == 'Track' || B.Type == 'Arc' || B.Type == 'Via') && A.intersectsFrontCourtyard('J3') && B.intersectsFrontCourtyard('J3')")
 (constraint clearance (min 0.20mm)))
(rule "CM5 Ethernet launch spacing on In2.Cu"
 (layer "In2.Cu")
 (condition "(A.hasNetclass('ETH_100R') || B.hasNetclass('ETH_100R')) && !AB.isCoupledDiffPair() && (A.Type == 'Track' || A.Type == 'Arc' || A.Type == 'Via') && (B.Type == 'Track' || B.Type == 'Arc' || B.Type == 'Via') && A.intersectsFrontCourtyard('J3') && B.intersectsFrontCourtyard('J3')")
 (constraint clearance (min 0.20mm)))

# Through vias share copper layers beyond the two routing layers.
(rule "CM5 Ethernet launch via spacing"
 (condition "(A.hasNetclass('ETH_100R') || B.hasNetclass('ETH_100R')) && !AB.isCoupledDiffPair() && A.Type == 'Via' && B.Type == 'Via' && A.intersectsFrontCourtyard('J3') && B.intersectsFrontCourtyard('J3')")
 (constraint clearance (min 0.20mm)))

# Clearance to nearby copper at the USB connector and USB data fanout.
(rule "USB-C launch copper spacing on F.Cu"
 (layer "F.Cu")
 (condition "(A.hasNetclass('USB_90R') || B.hasNetclass('USB_90R')) && !AB.isCoupledDiffPair() && (A.Type == 'Track' || A.Type == 'Arc' || A.Type == 'Via') && (B.Type == 'Track' || B.Type == 'Arc' || B.Type == 'Via') && ((A.intersectsFrontCourtyard('J10') && B.intersectsFrontCourtyard('J10')) || (A.intersectsFrontCourtyard('J5') && B.intersectsFrontCourtyard('J5')) || (A.intersectsFrontCourtyard('U11') && B.intersectsFrontCourtyard('U11')) || (A.intersectsFrontCourtyard('U13') && B.intersectsFrontCourtyard('U13')))")
 (constraint clearance (min 0.20mm)))
(rule "USB-C launch copper spacing on In2.Cu"
 (layer "In2.Cu")
 (condition "(A.hasNetclass('USB_90R') || B.hasNetclass('USB_90R')) && !AB.isCoupledDiffPair() && (A.Type == 'Track' || A.Type == 'Arc' || A.Type == 'Via') && (B.Type == 'Track' || B.Type == 'Arc' || B.Type == 'Via') && ((A.intersectsFrontCourtyard('J10') && B.intersectsFrontCourtyard('J10')) || (A.intersectsFrontCourtyard('J5') && B.intersectsFrontCourtyard('J5')) || (A.intersectsFrontCourtyard('U11') && B.intersectsFrontCourtyard('U11')) || (A.intersectsFrontCourtyard('U13') && B.intersectsFrontCourtyard('U13')))")
 (constraint clearance (min 0.20mm)))
(rule "USB-C launch via spacing"
 (condition "(A.hasNetclass('USB_90R') || B.hasNetclass('USB_90R')) && !AB.isCoupledDiffPair() && A.Type == 'Via' && B.Type == 'Via' && ((A.intersectsFrontCourtyard('J10') && B.intersectsFrontCourtyard('J10')) || (A.intersectsFrontCourtyard('J5') && B.intersectsFrontCourtyard('J5')) || (A.intersectsFrontCourtyard('U11') && B.intersectsFrontCourtyard('U11')) || (A.intersectsFrontCourtyard('U13') && B.intersectsFrontCourtyard('U13')))")
 (constraint clearance (min 0.20mm)))

# At J10, 0.50 mm pad pitch and 0.175 mm traces give 0.325 mm at the launch.
(rule "USB-C J10 data launch pair gap"
 (layer "F.Cu")
 (condition "A.hasNetclass('USB_90R') && A.intersectsFrontCourtyard('J10')")
 (constraint diff_pair_gap (min 0.15mm) (opt 0.30mm) (max 0.33mm)))

# U11 and U13 have 0.50 mm pad pitch, giving a 0.325 mm gap with 0.175 mm traces.
(rule "USB IC launch pair gap"
 (layer "F.Cu")
 (condition "A.hasNetclass('USB_90R') && (A.intersectsFrontCourtyard('U11') || A.intersectsFrontCourtyard('U13'))")
 (constraint diff_pair_gap (min 0.15mm) (opt 0.325mm) (max 0.33mm)))

# Let ground reach the plane between the Ethernet TVS signal escapes.
(rule "Ethernet TVS ground escape on F.Cu"
 (layer "F.Cu")
 (condition "((A.NetName == 'GND' && B.hasNetclass('ETH_100R')) || (B.NetName == 'GND' && A.hasNetclass('ETH_100R'))) && (A.Type == 'Track' || A.Type == 'Arc' || A.Type == 'Via') && (B.Type == 'Track' || B.Type == 'Arc' || B.Type == 'Via') && ((A.intersectsFrontCourtyard('U5') && B.intersectsFrontCourtyard('U5')) || (A.intersectsFrontCourtyard('U6') && B.intersectsFrontCourtyard('U6')))")
 (constraint clearance (min 0.20mm)))
(rule "Ethernet TVS ground escape on In2.Cu"
 (layer "In2.Cu")
 (condition "((A.NetName == 'GND' && B.hasNetclass('ETH_100R')) || (B.NetName == 'GND' && A.hasNetclass('ETH_100R'))) && (A.Type == 'Track' || A.Type == 'Arc' || A.Type == 'Via') && (B.Type == 'Track' || B.Type == 'Arc' || B.Type == 'Via') && ((A.intersectsFrontCourtyard('U5') && B.intersectsFrontCourtyard('U5')) || (A.intersectsFrontCourtyard('U6') && B.intersectsFrontCourtyard('U6')))")
 (constraint clearance (min 0.20mm)))
(rule "Ethernet TVS ground via spacing"
 (condition "((A.NetName == 'GND' && B.hasNetclass('ETH_100R')) || (B.NetName == 'GND' && A.hasNetclass('ETH_100R'))) && A.Type == 'Via' && B.Type == 'Via' && ((A.intersectsFrontCourtyard('U5') && B.intersectsFrontCourtyard('U5')) || (A.intersectsFrontCourtyard('U6') && B.intersectsFrontCourtyard('U6')))")
 (constraint clearance (min 0.20mm)))

# The SPI escape diverges just beyond J3's courtyard.
(rule "CM5 D0/D1 fanout clearance"
 (layer "F.Cu")
 (condition "A.Type == 'Track' && B.Type == 'Track' && ((A.NetName == '/CM5/D0' && B.NetName == '/CM5/D1') || (A.NetName == '/CM5/D1' && B.NetName == '/CM5/D0')) && A.intersectsArea('CM5 SPI fanout') && B.intersectsArea('CM5 SPI fanout')")
 (constraint clearance (min 0.20mm)))
(rule "CM5 SCLK/D1 fanout clearance"
 (layer "F.Cu")
 (condition "A.Type == 'Track' && B.Type == 'Track' && ((A.NetName == '/CM5/SCLK' && B.NetName == '/CM5/D1') || (A.NetName == '/CM5/D1' && B.NetName == '/CM5/SCLK')) && A.intersectsArea('CM5 SPI fanout') && B.intersectsArea('CM5 SPI fanout')")
 (constraint clearance (min 0.20mm)))

# Keep the local GND return close to the signal layer transition.
(rule "CM5 Ethernet return-via clearance"
 (condition "((A.Type == 'Via' && A.NetName == 'GND' && (B.NetName == '/CM5/ETH1_P' || B.NetName == '/CM5/ETH2_P')) || (B.Type == 'Via' && B.NetName == 'GND' && (A.NetName == '/CM5/ETH1_P' || A.NetName == '/CM5/ETH2_P'))) && A.intersectsArea('CM5 Ethernet return') && B.intersectsArea('CM5 Ethernet return')")
 (constraint clearance (min 0.33mm)))

# J9 has staggered through-hole contacts. Pair 2 separates across the two rows at the lands.
(rule "RJ45 pair 2 staggered lands"
 (layer "F.Cu")
 (condition "(A.NetName == '/CM5/ETH2_P' || A.NetName == '/CM5/ETH2_N') && A.intersectsArea('RJ45 staggered pair 2 lands')")
 (constraint diff_pair_gap (min 0.15mm) (opt 0.50mm) (max 1.15mm)))
(rule "RJ45 pair 3 fanout gap"
 (layer "F.Cu")
 (condition "(A.NetName == '/CM5/ETH3_P' || A.NetName == '/CM5/ETH3_N') && A.intersectsFrontCourtyard('J9')")
 (constraint diff_pair_gap (min 0.15mm) (opt 0.50mm) (max 0.53mm)))

# Gap limits for the short staggered transitions and reversible USB-C branches.
(rule "USB U11 staggered launch"
 (condition "AB.isCoupledDiffPair() && A.inDiffPair('/USB & Service/USB_D') && A.Type == 'Track' && B.Type == 'Track' && A.enclosedByArea('USB U11 staggered launch') && B.enclosedByArea('USB U11 staggered launch')")
 (constraint diff_pair_gap (min 0.15mm) (opt 0.30mm) (max 0.58mm)))
(rule "USB-C duplicate contacts"
 (condition "AB.isCoupledDiffPair() && A.inDiffPair('/USB & Service/USB_D') && A.Type == 'Track' && B.Type == 'Track' && A.enclosedByArea('USB-C duplicate contacts') && B.enclosedByArea('USB-C duplicate contacts')")
 (constraint diff_pair_gap (min 0.15mm) (opt 0.30mm) (max 2.02mm)))
(rule "USB-C inner-layer split"
 (condition "AB.isCoupledDiffPair() && A.inDiffPair('/USB & Service/USB_D') && A.Type == 'Track' && B.Type == 'Track' && A.enclosedByArea('USB-C inner-layer split') && B.enclosedByArea('USB-C inner-layer split')")
 (constraint diff_pair_gap (min 0.15mm) (opt 0.30mm) (max 1.9mm)))


# CNC-routed clearance around the two 10.32 mm rod holes.
(rule "Rod hole copper setback"
 (condition "(A.Type == 'Pad' && (A.memberOfFootprint('H1') || A.memberOfFootprint('H2'))) || (B.Type == 'Pad' && (B.memberOfFootprint('H1') || B.memberOfFootprint('H2')))")
 (constraint hole_clearance (min 0.50mm)))
