        <mxCell id="i2c" value="&lt;b&gt;I²C carrier sensors&lt;/b&gt;&lt;br&gt;BMI088 accel + gyro: 100 Hz each&lt;br&gt;BMP581 pressure + temperature: 25 Hz&lt;br&gt;INA226 voltage / current / power: 10 Hz" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;strokeColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=16;spacing=8;fillColor=#d4e4f4;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="200" width="360" height="180" />
        </mxCell>
        <mxCell id="read" value="&lt;b&gt;SensorWorker&lt;/b&gt;&lt;br&gt;sequence • host read timestamps&lt;br&gt;valid / status / values&lt;br&gt;Explicit I²C or simulation backend" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;strokeColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=16;spacing=8;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="490" y="200" width="300" height="180" />
        </mxCell>
        <mxCell id="log" value="&lt;b&gt;Full-rate local JSONL&lt;/b&gt;&lt;br&gt;Every acquired sample&lt;br&gt;Loss / write failures counted" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;strokeColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=16;spacing=8;fillColor=#d9ead3;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="900" y="200" width="300" height="180" />
        </mxCell>
        <mxCell id="uart" value="&lt;b&gt;FC → CM5 UART&lt;/b&gt;&lt;br&gt;RX-only • 115200 8N1&lt;br&gt;2 Hz heartbeat + event changes&lt;br&gt;3.3 V wiring still to confirm" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;strokeColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=16;spacing=8;fillColor=#d4e4f4;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="510" width="360" height="180" />
        </mxCell>
        <mxCell id="parse" value="&lt;b&gt;FlightUartParser&lt;/b&gt;&lt;br&gt;PV1 + seq + uptime + phase&lt;br&gt;event_seq + event + CRC16&lt;br&gt;≥3 s stale → UNKNOWN" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;strokeColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=16;spacing=8;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="490" y="510" width="300" height="180" />
        </mxCell>
        <mxCell id="batch" value="&lt;b&gt;PID 258 publication&lt;/b&gt;&lt;br&gt;Sensors: 100 ms column batches&lt;br&gt;≤2500 B / batch • sample times&lt;br&gt;UART / health: typed JSON" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;strokeColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=16;spacing=8;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="900" y="510" width="300" height="180" />
        </mxCell>
