  <diagram name="Startup and shutdown" id="startup-and-shutdown">
    <mxGraphModel dx="1580" dy="950" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1580" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Startup and shutdown" style="text;html=0;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=16;fontColor=#222222;fontSize=26;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="35" width="1500" height="45" />
        </mxCell>
        <mxCell id="subtitle" value="Proposed Yapogee S3 flight order; CM5 recording remains independent of transmitter readiness" style="text;html=0;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=16;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="90" width="1500" height="45" />
        </mxCell>
        <mxCell id="footer" value="PV-SPI message framing exists; complete carrier, converter and PA sequencing still needs implementation and tests" style="text;html=0;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=16;fontColor=#222222;fontSize=14;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="880" width="1500" height="30" />
        </mxCell>
        <mxCell id="rp" value="&lt;b&gt;Yapogee S3 startup&lt;/b&gt;&lt;br&gt;Boot with RF / PA off&lt;br&gt;Settle rails / ref; program LO&lt;br&gt;Load profile + IQ conjugation&lt;br&gt;Fresh SPI session → READY" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;strokeColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=16;spacing=8;fillColor=#d4e4f4;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="210" width="400" height="190" />
        </mxCell>
        <mxCell id="cm" value="&lt;b&gt;CM5 startup&lt;/b&gt;&lt;br&gt;systemd → lock → session&lt;br&gt;Independent cameras / sensors / UART&lt;br&gt;Start logs + MPEG-TS mux" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;strokeColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=16;spacing=8;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="590" y="210" width="400" height="190" />
        </mxCell>
        <mxCell id="send" value="&lt;b&gt;SPI transfer&lt;/b&gt;&lt;br&gt;Wait for fresh READY reading&lt;br&gt;One 1332-byte message / CS&lt;br&gt;Mode 0 • up to 20 MHz&lt;br&gt;≥10 µs gap; no ACK / retry" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;strokeColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=16;spacing=8;fillColor=#d9ead3;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1130" y="210" width="400" height="190" />
        </mxCell>
        <mxCell id="t1" value="Independent boot" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;strokeColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=16;spacing=8;fillColor=#f5f5f5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="450" y="255" width="130" height="55" />
        </mxCell>
        <mxCell id="t2" value="TS available" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=1.5;fontFamily=Arial;fontSize=14;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="cm" target="send">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="offset" x="0" y="-117.0" />
          </mxGeometry>
        </mxCell>
        <mxCell id="term" value="&lt;b&gt;CM5 stop request&lt;/b&gt;&lt;br&gt;SIGTERM / SIGINT&lt;br&gt;Stop camera / sensor / UART producers" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;strokeColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=16;spacing=8;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="590" width="400" height="165" />
        </mxCell>
        <mxCell id="drain" value="&lt;b&gt;CM5 finalize&lt;/b&gt;&lt;br&gt;Bounded transport drain&lt;br&gt;Close segments / logs&lt;br&gt;Write final counters" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;strokeColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=16;spacing=8;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="590" y="590" width="400" height="165" />
        </mxCell>
        <mxCell id="rstop" value="&lt;b&gt;Transmitter stop / fault&lt;/b&gt;&lt;br&gt;Mute PA / driver first&lt;br&gt;Stop RF and SPI reception&lt;br&gt;Save counters; RF / PA remain off" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;strokeColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=16;spacing=8;fillColor=#d4e4f4;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1130" y="590" width="400" height="165" />
        </mxCell>
        <mxCell id="t3" value="producer stop" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=1.5;fontFamily=Arial;fontSize=14;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="term" target="drain">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="offset" x="0" y="-104.5" />
          </mxGeometry>
        </mxCell>
        <mxCell id="t4" value="coordinated stop" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=1.5;fontFamily=Arial;fontSize=14;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=1;" edge="1" parent="1" source="drain" target="rstop">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="offset" x="0" y="-104.5" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n1" value="S3 input starvation produces DVB-S2 filler frames during a run. CM5 shutdown alone must not be treated as RF shutdown." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;strokeColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=16;spacing=8;fillColor=#f5f5f5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="455" width="1490" height="70" />
        </mxCell>
        <mxCell id="n2" value="Restart=no on CM5. An uncertain SPI transfer needs a fresh transmitter session; autonomous start/stop policy is pending." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;strokeColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=16;spacing=8;fillColor=#f5f5f5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="800" width="1490" height="60" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
