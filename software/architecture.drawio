        <mxCell id="parse" value="&lt;b&gt;FlightUartParser&lt;/b&gt;&lt;br&gt;PV1 + seq + uptime + phase&lt;br&gt;event_seq + event + CRC16&lt;br&gt;≥3 s stale → UNKNOWN" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;strokeColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=16;spacing=8;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="490" y="510" width="300" height="180" />
        </mxCell>
        <mxCell id="batch" value="&lt;b&gt;PID 258 publication&lt;/b&gt;&lt;br&gt;Sensors: 100 ms column batches&lt;br&gt;≤2500 B / batch • sample times&lt;br&gt;UART / health: typed JSON" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;strokeColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=16;spacing=8;fillColor=#ffffff;" vertex="1" parent="1">
