          <mxGeometry as="geometry" x="40" y="35" width="1500" height="45" />
        </mxCell>
        <mxCell id="subtitle" value="Separate pvflight target; iqbench retains its duration-based USB commands" style="text;html=0;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=16;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="90" width="1500" height="45" />
        </mxCell>
        <mxCell id="footer" value="Software implementation • hardware validation pending • analog chain untested/off" style="text;html=0;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=16;fontColor=#222222;fontSize=14;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="880" width="1500" height="30" />
        </mxCell>
        <mxCell id="boot" value="&lt;b&gt;BOOT&lt;/b&gt;&lt;br&gt;128 MHz • READY low" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;strokeColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=16;spacing=8;fillColor=#d4e4f4;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="260" width="250" height="135" />
        </mxCell>
        <mxCell id="profile" value="&lt;b&gt;LOAD PROFILE&lt;/b&gt;&lt;br&gt;QPSK normal 2/3 • pilots&lt;br&gt;4 samples/symbol • L=12" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;strokeColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=16;spacing=8;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="350" y="260" width="250" height="135" />
        </mxCell>
        <mxCell id="prefill" value="&lt;b&gt;PREFILL&lt;/b&gt;&lt;br&gt;TS nulls → coded symbols&lt;br&gt;Fill shaper / DMA ring" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;strokeColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=16;spacing=8;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="660" y="260" width="250" height="135" />
        </mxCell>
        <mxCell id="start" value="&lt;b&gt;DIGITAL START&lt;/b&gt;&lt;br&gt;Start PIO / DMA&lt;br&gt;Then arm external SPI" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;strokeColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=16;spacing=8;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="970" y="260" width="250" height="135" />
        </mxCell>
        <mxCell id="run" value="&lt;b&gt;RUNNING&lt;/b&gt;&lt;br&gt;Indefinite digital output&lt;br&gt;Null packets when TS absent" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;strokeColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=16;spacing=8;fillColor=#d9ead3;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1280" y="260" width="250" height="135" />
        </mxCell>
        <mxCell id="ready" value="&lt;b&gt;READY HIGH&lt;/b&gt;&lt;br&gt;Free receive slot armed&lt;br&gt;Lower while queue is full" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;strokeColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=16;spacing=8;fillColor=#d4e4f4;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1280" y="600" width="250" height="135" />
        </mxCell>
        <mxCell id="stop" value="&lt;b&gt;STOPPING&lt;/b&gt;&lt;br&gt;READY low first&lt;br&gt;Stop output • drain encoder" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;strokeColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=16;spacing=8;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="970" y="600" width="250" height="135" />
        </mxCell>
        <mxCell id="idle" value="&lt;b&gt;BENCH IDLE&lt;/b&gt;&lt;br&gt;Final stream counters&lt;br&gt;USB start / bench commands" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;strokeColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=16;spacing=8;fillColor=#d4e4f4;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="660" y="600" width="250" height="135" />
        </mxCell>
        <mxCell id="r1" value="autonomous" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=1.5;fontFamily=Arial;fontSize=14;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="boot" target="profile">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="offset" x="0" y="-89.5" />
          </mxGeometry>
        </mxCell>
        <mxCell id="r2" value="configure" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=1.5;fontFamily=Arial;fontSize=14;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="profile" target="prefill">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="offset" x="0" y="-89.5" />
          </mxGeometry>
        </mxCell>
        <mxCell id="r3" value="rings filled" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=1.5;fontFamily=Arial;fontSize=14;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="prefill" target="start">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="offset" x="0" y="-89.5" />
          </mxGeometry>
        </mxCell>
        <mxCell id="r4" value="receive armed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=1.5;fontFamily=Arial;fontSize=14;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="start" target="run">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="offset" x="0" y="-89.5" />
          </mxGeometry>
        </mxCell>
        <mxCell id="r5" value="buffer availability" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=1.5;fontFamily=Arial;fontSize=14;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="run" target="ready">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="r6" value="USB stop" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=1.5;fontFamily=Arial;fontSize=14;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="run" target="stop">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="1405" y="470" />
              <mxPoint x="1095" y="470" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="r7" value="finalize" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=1.5;fontFamily=Arial;fontSize=14;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="stop" target="idle">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="offset" x="0" y="-89.5" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n1" value="During TX: bounded stop/status service, no host wait. Status replies ≤1 Hz. No USB connection is needed to start." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;strokeColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=16;spacing=8;fillColor=#f5f5f5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="600" width="560" height="135" />
        </mxCell>
        <mxCell id="n2" value="READY is not RF readiness or a per-message ACK. AFE/LO/PA remain unconfigured. Autonomous continuity is hardware-unverified." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;strokeColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=16;spacing=8;fillColor=#f5f5f5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="800" width="1490" height="60" />
        </mxCell>
