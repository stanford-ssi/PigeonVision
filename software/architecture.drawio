        <mxCell id="i2c" value="&lt;b&gt;I²C carrier sensors&lt;/b&gt;&lt;br&gt;BMI088 accel + gyro: 100 Hz each&lt;br&gt;BMP581 pressure + temperature: 25 Hz&lt;br&gt;INA226 voltage / current / power: 10 Hz" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;strokeColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=16;spacing=8;fillColor=#d4e4f4;" vertex="1" parent="1">
