        <mxCell id="n1" value="Camera loss does not end telemetry. Invalid sensor data remains invalid. FC labels do not drive lifecycle or control." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;strokeColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=16;spacing=8;fillColor=#f5f5f5;" vertex="1" parent="1">
