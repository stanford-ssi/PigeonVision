  <diagram name="Yapogee S3 lifecycle" id="transmitter-lifecycle">
    <mxGraphModel dx="1580" dy="950" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1580" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Yapogee S3 lifecycle" style="text;html=0;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=16;fontColor=#222222;fontSize=26;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="35" width="1500" height="45" />
        </mxCell>
        <mxCell id="subtitle" value="Proposed flight sequence; esp-dvbs2 currently starts bounded runs through its console" style="text;html=0;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=16;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="90" width="1500" height="45" />
        </mxCell>
        <mxCell id="footer" value="New carrier GPIO, converter/PA control, autonomous startup and fault handling remain to be implemented" style="text;html=0;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=16;fontColor=#222222;fontSize=14;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="880" width="1500" height="30" />
        </mxCell>
        <mxCell id="boot" value="&lt;b&gt;BOOT / RESET&lt;/b&gt;&lt;br&gt;Selected 5 V → local rails&lt;br&gt;RF and external PA held off" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;strokeColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=16;spacing=8;fillColor=#d4e4f4;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="260" width="250" height="135" />
        </mxCell>
        <mxCell id="profile" value="&lt;b&gt;LOAD PROFILE&lt;/b&gt;&lt;br&gt;QPSK / 8PSK; rate to qualify&lt;br&gt;Apply IQ conjugation" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;strokeColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=16;spacing=8;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="350" y="260" width="250" height="135" />
        </mxCell>
        <mxCell id="prefill" value="&lt;b&gt;SET CONVERTER&lt;/b&gt;&lt;br&gt;Settle 3.0 V / 40 MHz ref&lt;br&gt;LO 3.70 GHz; calibrate / lock" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;strokeColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=16;spacing=8;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="660" y="260" width="250" height="135" />
        </mxCell>
        <mxCell id="start" value="&lt;b&gt;ARM TRANSPORT&lt;/b&gt;&lt;br&gt;Fresh SPI session / sequence&lt;br&gt;Prepare waveform + READY" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;strokeColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=16;spacing=8;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="970" y="260" width="250" height="135" />
        </mxCell>
        <mxCell id="run" value="&lt;b&gt;RUNNING&lt;/b&gt;&lt;br&gt;TS → DVB-S2 → 2.42 GHz&lt;br&gt;Driver / PA after RF checks" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;strokeColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=16;spacing=8;fillColor=#d9ead3;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1280" y="260" width="250" height="135" />
        </mxCell>
        <mxCell id="ready" value="&lt;b&gt;READY HIGH&lt;/b&gt;&lt;br&gt;Room for another message&lt;br&gt;Filler frames if TS starves" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;strokeColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=16;spacing=8;fillColor=#d4e4f4;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1280" y="600" width="250" height="135" />
        </mxCell>
        <mxCell id="stop" value="&lt;b&gt;STOPPING&lt;/b&gt;&lt;br&gt;Mute PA / driver first&lt;br&gt;Stop RF + SPI; save counters" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;strokeColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=16;spacing=8;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="970" y="600" width="250" height="135" />
        </mxCell>
        <mxCell id="idle" value="&lt;b&gt;IDLE&lt;/b&gt;&lt;br&gt;RF and PA off&lt;br&gt;Fresh session for next run" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;strokeColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=16;spacing=8;fillColor=#d4e4f4;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="660" y="600" width="250" height="135" />
        </mxCell>
        <mxCell id="r1" value="configuration" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=1.5;fontFamily=Arial;fontSize=14;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="boot" target="profile">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="offset" x="0" y="-89.5" />
          </mxGeometry>
        </mxCell>
        <mxCell id="r2" value="profile loaded" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=1.5;fontFamily=Arial;fontSize=14;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="profile" target="prefill">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="offset" x="0" y="-89.5" />
          </mxGeometry>
        </mxCell>
        <mxCell id="r3" value="lock checked" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=1.5;fontFamily=Arial;fontSize=14;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="prefill" target="start">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="offset" x="0" y="-89.5" />
          </mxGeometry>
        </mxCell>
        <mxCell id="r4" value="qualified start" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=1.5;fontFamily=Arial;fontSize=14;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="start" target="run">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="offset" x="0" y="-89.5" />
          </mxGeometry>
        </mxCell>
        <mxCell id="r5" value="buffer availability" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=1.5;fontFamily=Arial;fontSize=14;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="run" target="ready">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="r6" value="stop / fault" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=1.5;fontFamily=Arial;fontSize=14;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="run" target="stop">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="1405" y="470" />
              <mxPoint x="1095" y="470" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="r7" value="finalize" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=1.5;fontFamily=Arial;fontSize=14;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="stop" target="idle">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="offset" x="0" y="-89.5" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n1" value="The existing S3 reference firmware supplies waveform generation and PV-SPI input. Board startup and RF control are planned." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;strokeColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=16;spacing=8;fillColor=#f5f5f5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="600" width="560" height="135" />
        </mxCell>
        <mxCell id="n2" value="READY is input capacity, not PLL lock or an ACK. Match the actual waveform and gains before enabling the external PA." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;strokeColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=16;spacing=8;fillColor=#f5f5f5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="800" width="1490" height="60" />
        </mxCell>
